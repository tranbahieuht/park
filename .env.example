# SMTP provider credentials. Never prefix these with NEXT_PUBLIC_.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@example.com
SMTP_PASSWORD=replace-with-provider-password
# Bare mailbox addresses, not display-name syntax. Verify sender with your provider.
SMTP_FROM=sender@example.com
# SMTP_FROM must match SMTP_USER (an authorized mailbox).
# The API always sends registration emails to sales@savills.com.vn.

# Required in production/Vercel. Shared abuse counters and deduplication status only.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-write-token
LEAD_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
# During local development only, omit Redis URL/token to use an in-memory limiter.
